rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() { return request.auth != null && request.auth.token.admin == true; }
    match /product-images/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && request.resource.size < 12 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
    }
    match /site-media/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && request.resource.size < 20 * 1024 * 1024;
    }
  }
}
