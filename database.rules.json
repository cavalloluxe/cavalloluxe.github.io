{
  "rules": {
    ".read": false,
    ".write": false,
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "store": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).child('role').val() === 'admin')",
      ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).child('role').val() === 'admin')",
      "products": { ".read": true },
      "coupons": { ".read": true },
      "cms": { ".read": true },
      "orders": {
        "$orderId": {
          ".write": "(auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).child('role').val() === 'admin')) || (!data.exists() && newData.hasChildren(['id','at','name','phone','items','status','method']) && newData.child('id').val() === $orderId && newData.child('status').val() === 'pending')",
          ".validate": "newData.hasChildren(['id','at','name','phone','items','status','method'])"
        }
      }
    }
  }
}
